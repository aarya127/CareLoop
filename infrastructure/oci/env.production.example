# Production environment for the OCI VM — copy to /opt/careloop/.env on the
# server and fill in real values. NEVER commit the filled-in version.
# Values marked (Render) can be copied from the Render dashboard env vars.

# Public URL of the API (Caddy uses this for HTTPS certs)
API_DOMAIN=api.yourdomain.com

# Frontend (stays on Vercel)
WEB_URL=https://your-app.vercel.app
APP_BASE_URL=https://your-app.vercel.app

# Database — Neon (Render)
DATABASE_URL=

# Sessions / crypto (Render — copy the generated values so existing sessions survive)
COOKIE_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_SECONDS=86400
SESSION_COOKIE=cl_session

# S3 document storage (Render)
STORAGE_BUCKET=careloop-383418748732-ca-central-1-documents
STORAGE_REGION=ca-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Twilio — reminder SMS (Render)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP — reminder email (Render)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Calendar integration (Render, if configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
